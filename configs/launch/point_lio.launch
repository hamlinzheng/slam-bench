<launch>
  <!-- slam-bench Point-LIO run. Mirrors upstream mapping_avia.launch parameters
       verbatim (as-shipped defaults) — including use_imu_as_input=0,
       Point-LIO's own default of treating the IMU as a measurement rather than an
       input. Only the config path points to our override and rviz defaults off
       (headless benchmark).

       The `config` arg name matters: run_system.sh reads it to find the YAML that
       goes into preset_sha alongside this file. -->
  <arg name="rviz" default="false" />
  <arg name="config" default="/slam-bench/configs/systems/point_lio_mid360.yaml" />

  <node pkg="point_lio" type="pointlio_mapping" name="laserMapping" output="screen">
    <rosparam command="load" file="$(arg config)" />
    <param name="use_imu_as_input"       type="bool"   value="0" />
    <param name="prop_at_freq_of_imu"    type="bool"   value="1" />
    <param name="check_satu"             type="bool"   value="1" />
    <param name="init_map_size"          type="int"    value="10" />
    <param name="point_filter_num"       type="int"    value="1" />
    <param name="space_down_sample"      type="bool"   value="1" />
    <param name="filter_size_surf"       type="double" value="0.5" />
    <param name="filter_size_map"        type="double" value="0.4" />
    <param name="ivox_nearby_type"       type="int"    value="6" />
    <param name="runtime_pos_log_enable" type="bool"   value="0" />
  </node>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find point_lio)/rviz_cfg/loam_livox.rviz" />
  </group>
</launch>
