# Per-system build workspaces (created inside the container by build_systems.sh)
.ws/

# Run outputs (keep the folder, drop its contents)
results/*/
!results/.gitkeep
# Generated by `bench.sh summary` from those outputs, so it is one too — and being a file
# rather than a directory it slips past the rule above.
results/SUMMARY.md

# Bags are never committed
bags/

# The filled bag registry: site names, dates and route characteristics are site
# information, not harness configuration. configs/bags.yaml ships as the documented shape.
configs/bags.local.yaml

# Python
__pycache__/
*.pyc
